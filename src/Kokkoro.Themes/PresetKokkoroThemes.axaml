<Styles x:Class="Kokkoro.Themes.PresetKokkoroThemes"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Kokkoro.Themes;assembly=Kokkoro.Themes">
    <Design.PreviewWith>
        <Border Padding="20">
            <Button Content="Test" ></Button>
        </Border>
    </Design.PreviewWith>
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="{x:Static themes:PresetKokkoroThemes.KokkoroLight}"
                                 Source="avares://Kokkoro.Themes/Themes/Kokkoro/Light/_index.axaml" />
                <ResourceInclude x:Key="{x:Static themes:PresetKokkoroThemes.KokkoroDark}"
                                 Source="avares://Kokkoro.Themes/Themes/Kokkoro/Dark/_index.axaml" />

                <ResourceInclude x:Key="{x:Static themes:PresetKokkoroThemes.OceanLight}"
                                 Source="avares://Kokkoro.Themes/Themes/Ocean/Light/_index.axaml" />
                <ResourceInclude x:Key="{x:Static themes:PresetKokkoroThemes.OceanDark}"
                                 Source="avares://Kokkoro.Themes/Themes/Ocean/Dark/_index.axaml" />

                <ResourceInclude x:Key="{x:Static themes:PresetKokkoroThemes.ForestLight}"
                                 Source="avares://Kokkoro.Themes/Themes/Forest/Light/_index.axaml" />
                <ResourceInclude x:Key="{x:Static themes:PresetKokkoroThemes.ForestDark}"
                                 Source="avares://Kokkoro.Themes/Themes/Forest/Dark/_index.axaml" />
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kokkoro.Themes/Tokens/_index.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>

