<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Kokkoro.Admin.Models"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:Kokkoro.Admin.ViewModels"
             x:Class="Kokkoro.Admin.Views.AdminTreeView"
             x:DataType="vm:AdminTreeViewModel"
             MinHeight="0"
             MinWidth="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <u:LoadingContainer Margin="16"
                        MinHeight="0"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="Transparent"
                        IsLoading="{Binding IsLoading}"
                        LoadingMessage="加载中...">
        <Grid MinHeight="0"
              MinWidth="0"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="16">
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="树形结构" />

            <Border Grid.Row="1"
                    Padding="16"
                    Background="{DynamicResource SemiColorBg0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid ColumnDefinitions="Auto,260,*,Auto,Auto"
                      ColumnSpacing="12">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText2}"
                               Text="关键词" />
                    <TextBox Grid.Column="1"
                             PlaceholderText="节点名称或类型"
                             Text="{Binding Keyword, Mode=TwoWay}" />
                    <Button Grid.Column="3"
                            Command="{Binding QueryCommand}"
                            Content="查询" />
                    <Button Grid.Column="4"
                            Command="{Binding ResetCommand}"
                            Content="重置" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    MinHeight="360"
                    MinWidth="0"
                    Background="{DynamicResource SemiColorBg0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid RowDefinitions="Auto,*">
                    <Grid Margin="16,10"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource SemiColorText2}"
                                   Text="{Binding VisibleNodeCount, StringFormat='显示 {0} 个节点'}" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <u:IconButton Classes="Small Secondary"
                                          Icon="{StaticResource SemiIconChevronDown}"
                                          Content="展开全部"
                                          Click="OnExpandAllClick"
                                          Theme="{DynamicResource OutlineIconButton}" />
                            <u:IconButton Classes="Small Secondary"
                                          Icon="{StaticResource SemiIconChevronUp}"
                                          Content="折叠全部"
                                          Click="OnCollapseAllClick"
                                          Theme="{DynamicResource OutlineIconButton}" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <TreeView x:Name="NodeTreeView"
                                  Margin="8,0,8,8"
                                  ItemsSource="{Binding TreeNodes}">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="models:AdminTreeNode"
                                                  ItemsSource="{Binding Children}">
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding Name}" />
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </u:LoadingContainer>
</UserControl>
