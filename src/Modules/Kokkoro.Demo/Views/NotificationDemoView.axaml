<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:Kokkoro.Sample.ViewModels"
             x:Class ="Kokkoro.Sample.Views.NotificationDemoView"
             x:DataType="vm:NotificationDemoViewModel"
             mc:Ignorable="d">
    <Design.DataContext>
        <vm:NotificationDemoViewModel />
    </Design.DataContext>

    <ScrollViewer Margin="16"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <Border Padding="18"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="窗口通知演示" />
                    <TextBlock Foreground="{DynamicResource SemiColorText2}"
                               Text="展示窗口通知的调用方式" />
                </StackPanel>
            </Border>

            <Border Padding="14"
                    Background="{DynamicResource SemiColorFill0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1">
                <Grid ColumnDefinitions="110,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="10">
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource SemiColorText2}"
                               Text="消息内容" />
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             AcceptsReturn="True"
                             MinHeight="84"
                             TextWrapping="Wrap"
                             Text="{Binding CustomMessage, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText2}"
                               Text="标题（可空）" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             PlaceholderText="留空则使用默认标题"
                             Text="{Binding CustomTitle, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Padding="14"
                    Background="{DynamicResource SemiColorFill0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="窗口通知演示" />
                        <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                   Text="这一页专门配置和测试窗口通知，参数和操作集中在一起更方便观察效果。" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="16"
                          RowDefinitions="Auto">
                        <Border Grid.Column="0"
                                Padding="14"
                                Background="{DynamicResource SemiColorFill0}"
                                BorderBrush="{DynamicResource SemiColorBorder}"
                                BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="窗口通知设置" />
                                    <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                               Text="适合通知条一类的持续提示。" />
                                </StackPanel>
                                <Grid ColumnDefinitions="100,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="10">
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               Text="通知时长" />
                                    <u:NumericIntUpDown Grid.Row="0"
                                                        Grid.Column="1"
                                                        Minimum="1"
                                                        Maximum="60"
                                                        Value="{Binding Timeout, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               Text="通知数量" />
                                    <u:NumericIntUpDown Grid.Row="1"
                                                        Grid.Column="1"
                                                        Minimum="1"
                                                        Maximum="10"
                                                        Value="{Binding MaxItems, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               Text="通知外观" />
                                    <StackPanel Grid.Row="2"
                                                Grid.Column="1"
                                                Spacing="8">
                                        <ToggleSwitch IsChecked="{Binding ShowIcon, Mode=TwoWay}"
                                                      Content="显示图标" />
                                        <ToggleSwitch IsChecked="{Binding ShowClose, Mode=TwoWay}"
                                                      Content="显示关闭按钮" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="样式："
                                                       VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding SelectedStyleDisplay}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               Text="通知位置" />
                                    <ComboBox Grid.Row="3"
                                              Grid.Column="1"
                                              ItemsSource="{Binding NotificationPositions}"
                                              SelectedItem="{Binding SelectedNotificationPosition, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Padding="16"
                                Background="{DynamicResource SemiColorBg0}"
                                BorderBrush="{DynamicResource SemiColorBorder}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="通知类型" />
                                    <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                               Text="发送不同类型的窗口通知，观察图标、关闭按钮、位置和浅色模式的组合效果。" />
                                </StackPanel>
                                <WrapPanel Orientation="Horizontal"
                                           ItemSpacing="8"
                                           LineSpacing="8">
                                    <Button MinWidth="110"
                                            Command="{Binding ShowInfoCommand}"
                                            CommandParameter="{x:Null}"
                                            Content="信息通知" />
                                    <Button MinWidth="110"
                                            Classes="Success"
                                            Command="{Binding ShowSuccessCommand}"
                                            Content="成功通知" />
                                    <Button MinWidth="110"
                                            Classes="Warning"
                                            Command="{Binding ShowWarningCommand}"
                                            Content="警告通知" />
                                    <Button MinWidth="110"
                                            Classes="Danger"
                                            Command="{Binding ShowErrorCommand}"
                                            Content="错误通知" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
