<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kokkoro.Sample.ViewModels"
             x:Class="Kokkoro.Sample.Views.OverlayDialogServiceDemoContentView"
             x:DataType="vm:OverlayDialogServiceDemoContentViewModel">
    <Border Padding="16">
        <StackPanel Spacing="14">
            <TextBlock Foreground="{DynamicResource SemiColorText2}"
                       Text="该视图由 OverlayDialogService 显示，并在确认时返回模板名称。"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="88,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource SemiColorText2}"
                           Text="模板名称" />
                <TextBox Grid.Column="1"
                         Text="{Binding Name, Mode=TwoWay}" />

                <TextBlock Grid.Row="1"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource SemiColorText2}"
                           Text="模板说明" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         AcceptsReturn="True"
                         MinHeight="96"
                         TextWrapping="Wrap"
                         Text="{Binding Description, Mode=TwoWay}" />

                <TextBlock Grid.Row="2"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SemiColorText2}"
                           Text="启用模板" />
                <ToggleSwitch Grid.Row="2"
                              Grid.Column="1"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
            </Grid>

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button MinWidth="88"
                        Command="{Binding CancelCommand}"
                        Content="取消" />
                <Button MinWidth="88"
                        Classes="Primary"
                        Command="{Binding ConfirmCommand}"
                        Content="确认" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
