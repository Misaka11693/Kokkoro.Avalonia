<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:Kokkoro.Sample.ViewModels"
             x:Class="Kokkoro.Sample.Views.NotificationDemoView"
             x:DataType="vm:NotificationDemoViewModel"
             mc:Ignorable="d">
    <Design.DataContext>
        <vm:NotificationDemoViewModel />
    </Design.DataContext>

    <ScrollViewer Margin="16"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Text="窗口通知" />
                <TextBlock Foreground="{DynamicResource SemiColorText2}"
                           Text="配置通知内容和显示方式，然后发送不同类型的通知。" />
            </StackPanel>

            <Border Padding="14"
                    Background="{DynamicResource SemiColorFill0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1">
                <Grid ColumnDefinitions="110,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="10">
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource SemiColorText2}"
                               Text="消息内容" />
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             AcceptsReturn="True"
                             MinHeight="84"
                             TextWrapping="Wrap"
                             Text="{Binding CustomMessage, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText2}"
                                Text="通知标题（可选）" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             PlaceholderText="留空则使用默认标题"
                             Text="{Binding CustomTitle, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="16"
                  RowDefinitions="Auto">
                <Border Grid.Column="0"
                        Padding="16"
                        Background="{DynamicResource SemiColorBg0}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="通知设置" />
                            <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                       Text="控制通知的显示时长、数量和外观。" />
                        </StackPanel>
                        <Grid ColumnDefinitions="110,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="10">
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       Text="显示时长（秒）" />
                            <u:NumericIntUpDown Grid.Row="0"
                                                Grid.Column="1"
                                                Width="120"
                                                Minimum="1"
                                                Maximum="60"
                                                Value="{Binding Timeout, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       Text="最多同时显示" />
                            <u:NumericIntUpDown Grid.Row="1"
                                                Grid.Column="1"
                                                Width="120"
                                                Minimum="1"
                                                Maximum="10"
                                                Value="{Binding MaxItems, Mode=TwoWay}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       Text="显示图标" />
                            <ToggleSwitch Grid.Row="2"
                                          Grid.Column="1"
                                          IsChecked="{Binding ShowIcon, Mode=TwoWay}" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       Text="显示关闭按钮" />
                            <ToggleSwitch Grid.Row="3"
                                          Grid.Column="1"
                                          IsChecked="{Binding ShowClose, Mode=TwoWay}" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       Text="通知样式" />
                            <ComboBox Grid.Row="4"
                                      Grid.Column="1"
                                      ItemsSource="{Binding StyleOptions}"
                                      SelectedItem="{Binding SelectedStyleDisplay, Mode=TwoWay}" />

                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       Text="通知位置" />
                            <ComboBox Grid.Row="5"
                                      Grid.Column="1"
                                      ItemsSource="{Binding NotificationPositions}"
                                      SelectedItem="{Binding SelectedNotificationPosition, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Padding="16"
                        Background="{DynamicResource SemiColorBg0}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="通知类型" />
                            <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                       Text="发送不同状态的通知，观察配置效果。" />
                        </StackPanel>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="8"
                                   LineSpacing="8">
                            <Button MinWidth="110"
                                    Command="{Binding ShowInfoCommand}"
                                    Content="信息通知" />
                            <Button MinWidth="110"
                                    Classes="Success"
                                    Command="{Binding ShowSuccessCommand}"
                                    Content="成功通知" />
                            <Button MinWidth="110"
                                    Classes="Warning"
                                    Command="{Binding ShowWarningCommand}"
                                    Content="警告通知" />
                            <Button MinWidth="110"
                                    Classes="Danger"
                                    Command="{Binding ShowErrorCommand}"
                                    Content="错误通知" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
