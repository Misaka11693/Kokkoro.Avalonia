<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 列头浅灰底 + 竖向分隔，对齐常见业务表格样式 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="DataGridColumnHeaderBackground" ResourceKey="SemiColorFill0" />
            <StaticResource x:Key="DataGridColumnHeaderForeground" ResourceKey="SemiColorText0" />
            <StaticResource x:Key="DataGridColumnHeaderPointeroverBackground" ResourceKey="SemiColorFill1" />
            <StaticResource x:Key="DataGridColumnHeaderPressedBackground" ResourceKey="SemiColorFill2" />
            <StaticResource x:Key="DataGridRowAlternateBackground" ResourceKey="SemiGrey0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="DataGridColumnHeaderBackground" ResourceKey="SemiColorFill0" />
            <StaticResource x:Key="DataGridColumnHeaderForeground" ResourceKey="SemiColorText0" />
            <StaticResource x:Key="DataGridColumnHeaderPointeroverBackground" ResourceKey="SemiColorFill1" />
            <StaticResource x:Key="DataGridColumnHeaderPressedBackground" ResourceKey="SemiColorFill2" />
            <StaticResource x:Key="DataGridRowAlternateBackground" ResourceKey="SemiGrey0" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
