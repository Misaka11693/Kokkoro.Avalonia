<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kokkoro.ViewModels.Pages"
             xmlns:messages="using:Kokkoro.Views.Pages.Messages"
             xmlns:overlayDialogs="using:Kokkoro.Views.Pages.OverlayDialogs"
             x:Class="Kokkoro.Views.Pages.OverlayDialogsPageView"
             x:DataType="vm:OverlayDialogsPageViewModel"
             MinHeight="0"
             MinWidth="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent"
             Focusable="True">

    <ScrollViewer Margin="16"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040"
                    Spacing="16"
                    HorizontalAlignment="Stretch">

            <Border Padding="18"
                    Background="{DynamicResource SemiColorBg0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="OverlayDialog 演示" />
                        <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                   Text="这里专门演示新的 OverlayDialog 服务，包括标准弹窗、自定义弹窗，以及模态和非模态两种打开方式。" />
                    </StackPanel>

                    <messages:MessagesEditorSectionView DataContext="{Binding Editor}" />
                </StackPanel>
            </Border>

            <overlayDialogs:OverlayDialogsSectionView DataContext="{Binding OverlayDialogs}" />

            <messages:MessagesResultSectionView DataContext="{Binding Result}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
