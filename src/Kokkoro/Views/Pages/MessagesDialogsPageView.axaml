<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kokkoro.ViewModels.Pages"
             xmlns:messages="using:Kokkoro.Views.Pages.Messages"
             x:Class="Kokkoro.Views.Pages.MessagesDialogsPageView"
             x:DataType="vm:MessagesDialogsPageViewModel"
             MinHeight="0"
             MinWidth="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent"
             Focusable="True">

    <ScrollViewer Margin="16"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040"
                    Spacing="16"
                    HorizontalAlignment="Stretch">

            <Border Padding="18"
                    Background="{DynamicResource SemiColorBg0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="对话框演示" />
                        <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                   Text="集中演示桌面模态对话框和覆盖层对话框，作为独立页面单独查看更清晰。" />
                    </StackPanel>

                    <messages:MessagesEditorSectionView DataContext="{Binding Editor}" />
                </StackPanel>
            </Border>

            <messages:MessagesDialogsSectionView DataContext="{Binding Dialogs}" />

            <messages:MessagesResultSectionView DataContext="{Binding Result}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
