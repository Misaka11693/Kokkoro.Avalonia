<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Kokkoro.Controls"
             xmlns:models="using:Kokkoro.Models"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:Kokkoro.ViewModels.Pages"
             x:Class="Kokkoro.Views.Pages.TreePageView"
             x:Name="TreePageRoot"
             x:DataType="vm:TreePageViewModel"
             MinHeight="0"
             MinWidth="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent"
             Focusable="True">
    <u:LoadingContainer MinWidth="0"
                        MinHeight="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="Transparent"
                        IsLoading="{Binding IsLoading}"
                        LoadingMessage="加载中...">
        <Grid Margin="5"
              MinWidth="0"
              MinHeight="0"
              RowDefinitions="*">
            <Border MinHeight="0"
                    MinWidth="0"
                    Background="{DynamicResource SemiColorBg0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid MinHeight="0"
                      MinWidth="0"
                      RowDefinitions="Auto,*,Auto">

                    <!-- 工具栏 -->
                    <controls:DocumentCommandBar Grid.Row="0">
                        <u:IconButton Classes="Small Primary"
                                      Icon="{StaticResource SemiIconPlus}"
                                      Content="新增"
                                      Command="{Binding AddCommand}"
                                      Theme="{DynamicResource OutlineIconButton}" />
                        <u:IconButton Classes="Small Secondary"
                                      Icon="{StaticResource SemiIconEdit}"
                                      Content="修改"
                                      Command="{Binding EditCommand}"
                                      Theme="{DynamicResource OutlineIconButton}" />
                        <u:IconButton Classes="Small Danger"
                                      Icon="{StaticResource SemiIconDelete}"
                                      Content="删除"
                                      Command="{Binding DeleteCommand}"
                                      Theme="{DynamicResource OutlineIconButton}" />
                        <controls:DocumentCommandBarSeparator />
                        <u:IconButton Classes="Small Secondary"
                                      Icon="{StaticResource SemiIconChevronDown}"
                                      Content="展开全部"
                                      Click="OnExpandAllClick"
                                      Theme="{DynamicResource OutlineIconButton}" />
                        <u:IconButton Classes="Small Secondary"
                                      Icon="{StaticResource SemiIconChevronUp}"
                                      Content="折叠全部"
                                      Click="OnCollapseAllClick"
                                      Theme="{DynamicResource OutlineIconButton}" />
                        <u:IconButton Classes="Small Secondary"
                                      Icon="{StaticResource SemiIconRefresh}"
                                      Content="刷新"
                                      Command="{Binding RefreshCommand}"
                                      Theme="{DynamicResource OutlineIconButton}" />
                        <controls:DocumentCommandBarSeparator />
                        <u:IconButton Classes="Small Success"
                                      Icon="{StaticResource SemiIconSave}"
                                      Content="保存"
                                      Command="{Binding SaveCommand}"
                                      Theme="{DynamicResource SolidIconButton}" />
                    </controls:DocumentCommandBar>

                    <!-- 列标题行 -->
                    <Border Grid.Row="1"
                            MinHeight="0"
                            MinWidth="0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource SemiColorFill0}"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="0,0,0,1"
                            ZIndex="1">
                        <Grid Margin="32,0,16,0"
                              ColumnDefinitions="*,120,200,80,80,150"
                              ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       MinWidth="120"
                                       Padding="8,6"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SemiColorText1}"
                                       Text="名称" />
                            <TextBlock Grid.Column="1"
                                       Padding="8,6"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SemiColorText1}"
                                       Text="类型" />
                            <TextBlock Grid.Column="2"
                                       Padding="8,6"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SemiColorText1}"
                                       Text="描述" />
                            <TextBlock Grid.Column="3"
                                       Padding="8,6"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SemiColorText1}"
                                       Text="排序" />
                            <TextBlock Grid.Column="4"
                                       Padding="8,6"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SemiColorText1}"
                                       Text="状态" />
                            <TextBlock Grid.Column="5"
                                       Padding="8,6"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SemiColorText1}"
                                       Text="创建时间" />
                        </Grid>
                    </Border>

                    <!-- 树形内容 -->
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,32,0,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <TreeView x:Name="NodeTreeView"
                                  MinHeight="0"
                                  MinWidth="0"
                                  Padding="0"
                                  ItemsSource="{Binding TreeNodes}"
                                  SelectionMode="Single"
                                  SelectionChanged="OnTreeViewSelectionChanged">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="models:TreeNode"
                                                  ItemsSource="{Binding Children}">
                                    <Grid ColumnDefinitions="*,120,200,80,80,150"
                                          ColumnSpacing="8">
                                        <TextBlock Grid.Column="0"
                                                   MinWidth="120"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   Text="{Binding Type}" />
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   Text="{Binding Order}" />
                                        <TextBlock Grid.Column="4"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   Text="{Binding StatusText}" />
                                        <TextBlock Grid.Column="5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                    </Grid>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>

                    <!-- 底栏统计 -->
                    <Border Grid.Row="2"
                            Padding="8,6"
                            Background="{DynamicResource SemiColorFill0}"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="16"
                                    VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                       Text="{Binding TotalCount, StringFormat='共 {0} 条'}" />
                            <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                       Text="{Binding SelectedCount, StringFormat='已选 {0} 条'}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </u:LoadingContainer>
</UserControl>
