<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Kokkoro.Models"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:Kokkoro.ViewModels.Pages"
             x:Class="Kokkoro.Views.Pages.SimpleTreePageView"
             x:DataType="vm:SimpleTreePageViewModel"
             MinHeight="0"
             MinWidth="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <u:LoadingContainer MinWidth="0"
                        MinHeight="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="Transparent"
                        IsLoading="{Binding IsLoading}"
                        LoadingMessage="加载中...">
        <Border Margin="5"
                MinHeight="0"
                MinWidth="0"
                Background="{DynamicResource SemiColorBg0}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid MinHeight="0"
                  MinWidth="0"
                  RowDefinitions="Auto,*">

                <!-- 工具栏 -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="8,6">
                    <u:IconButton Classes="Small Secondary"
                                  Icon="{StaticResource SemiIconChevronDown}"
                                  Content="展开全部"
                                  Click="OnExpandAllClick"
                                  Theme="{DynamicResource OutlineIconButton}" />
                    <u:IconButton Classes="Small Secondary"
                                  Icon="{StaticResource SemiIconChevronUp}"
                                  Content="折叠全部"
                                  Click="OnCollapseAllClick"
                                  Theme="{DynamicResource OutlineIconButton}" />
                    <u:IconButton Classes="Small Secondary"
                                  Icon="{StaticResource SemiIconRefresh}"
                                  Content="刷新"
                                  Command="{Binding RefreshCommand}"
                                  Theme="{DynamicResource OutlineIconButton}" />
                </StackPanel>

                <!-- 树形内容 -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <TreeView x:Name="NodeTreeView"
                              Margin="4"
                              MinHeight="0"
                              MinWidth="0"
                              ItemsSource="{Binding TreeNodes}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="models:TreeNode"
                                              ItemsSource="{Binding Children}">
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Name}" />
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </Grid>
        </Border>
    </u:LoadingContainer>
</UserControl>
