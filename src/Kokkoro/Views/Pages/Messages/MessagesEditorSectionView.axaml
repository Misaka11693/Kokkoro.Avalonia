<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kokkoro.ViewModels.Pages"
             x:Class="Kokkoro.Views.Pages.Messages.MessagesEditorSectionView"
             x:DataType="vm:MessagesEditorViewModel">
    <Border Padding="14"
            Background="{DynamicResource SemiColorFill0}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid ColumnDefinitions="110,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="10">
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Top"
                       Foreground="{DynamicResource SemiColorText2}"
                       Text="消息内容" />
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     MinHeight="84"
                     TextWrapping="Wrap"
                     Text="{Binding CustomMessage, Mode=TwoWay}" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SemiColorText2}"
                       Text="标题（可空）" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     PlaceholderText="留空则使用默认标题"
                     Text="{Binding CustomTitle, Mode=TwoWay}" />
        </Grid>
    </Border>
</UserControl>
