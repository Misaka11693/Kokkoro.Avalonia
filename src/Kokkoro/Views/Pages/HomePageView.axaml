<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kokkoro.ViewModels.Pages"
             x:Class="Kokkoro.Views.Pages.HomePageView"
             x:DataType="vm:HomePageViewModel"
             MinHeight="0"
             MinWidth="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent"
             Focusable="True">
    <UserControl.Styles>
        <Style Selector="Button.home-link-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.home-link-card:pointerover Border.home-link-card-border">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <Style Selector="Button.home-link-card:pressed Border.home-link-card-border">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28"
                    Spacing="28">
            <!-- Hero -->
            <Border Padding="0"
                    CornerRadius="16"
                    ClipToBounds="True"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <Border Height="4"
                            Background="{DynamicResource SemiColorPrimary}" />

                    <Grid Grid.Row="1"
                          Margin="28,24"
                          Background="{DynamicResource SemiColorFill0}"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="24">
                        <Panel Width="88"
                               Height="88">
                            <Border Width="88"
                                    Height="88"
                                    CornerRadius="22"
                                    Opacity="0.18"
                                    Background="{DynamicResource SemiColorPrimary}" />
                            <Border Width="72"
                                    Height="72"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="18"
                                    Background="{DynamicResource SemiColorFill0}"
                                    BorderBrush="{DynamicResource SemiColorPrimary}"
                                    BorderThickness="2">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SemiColorPrimary}"
                                           Text="K" />
                            </Border>
                        </Panel>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="{DynamicResource SemiFontSizeRegular}"
                                           Foreground="{DynamicResource SemiColorText2}"
                                           Text="{Binding Greeting}" />
                                <Border Padding="8,2"
                                        VerticalAlignment="Center"
                                        CornerRadius="10"
                                        Background="{DynamicResource SemiColorFill1}"
                                        BorderBrush="{DynamicResource SemiColorBorder}"
                                        BorderThickness="1">
                                    <TextBlock FontSize="{DynamicResource SemiFontSizeSmall}"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               Text="{Binding VersionLabel}" />
                                </Border>
                            </StackPanel>

                            <TextBlock FontSize="{DynamicResource SemiFontSizeHeader2}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SemiColorText0}"
                                       Text="{Binding Headline}" />

                            <TextBlock FontSize="{DynamicResource SemiFontSizeHeader6}"
                                       Foreground="{DynamicResource SemiColorPrimary}"
                                       Text="{Binding Tagline}" />

                            <TextBlock Margin="0,4,0,0"
                                       MaxWidth="640"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       TextWrapping="Wrap"
                                       Text="{Binding Summary}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Stats -->
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="12">
                <Border Padding="16,14"
                        Theme="{DynamicResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="{DynamicResource SemiFontSizeHeader4}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorPrimary}"
                                   Text="{Binding OpenDocumentCount}" />
                        <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                   Text="已打开文档" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Padding="16,14"
                        Theme="{DynamicResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="{DynamicResource SemiFontSizeHeader4}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText0}"
                                   Text="4" />
                        <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                   Text="快捷入口模块" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="16,14"
                        Theme="{DynamicResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="{DynamicResource SemiFontSizeHeader4}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText0}"
                                   Text="Ctrl + 滚轮" />
                        <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                   Text="页面布局缩放" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick links -->
            <StackPanel Spacing="12">
                <TextBlock FontSize="{DynamicResource SemiFontSizeHeader5}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SemiColorText0}"
                           Text="快速开始" />

                <ItemsControl ItemsSource="{Binding QuickLinks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"
                                         ColumnSpacing="12"
                                         RowSpacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:HomeQuickLinkViewModel">
                            <Button Classes="home-link-card"
                                    Command="{Binding OpenCommand}">
                                <Border Classes="home-link-card-border"
                                        Padding="18"
                                        Theme="{DynamicResource CardBorder}">
                                    <Grid RowDefinitions="Auto,Auto,Auto"
                                          RowSpacing="12">
                                        <Border Width="44"
                                                Height="44"
                                                HorizontalAlignment="Left"
                                                CornerRadius="12"
                                                Background="{Binding IconBackground}">
                                            <PathIcon Width="22"
                                                      Height="22"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{Binding IconForeground}"
                                                      Theme="{DynamicResource InnerPathIcon}"
                                                      Data="{Binding Icon}" />
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   FontSize="{DynamicResource SemiFontSizeHeader6}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SemiColorText0}"
                                                   Text="{Binding Title}" />

                                        <TextBlock Grid.Row="2"
                                                   MinHeight="40"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Description}" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Highlights + tips -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">
                <Border Theme="{DynamicResource CardBorder}">
                    <StackPanel Margin="20"
                                Spacing="14">
                        <TextBlock FontSize="{DynamicResource SemiFontSizeHeader6}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText0}"
                                   Text="工作台亮点" />

                        <ItemsControl ItemsSource="{Binding Highlights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:HomeHighlightViewModel">
                                    <Grid Margin="0,0,0,12"
                                          ColumnDefinitions="Auto,*"
                                          ColumnSpacing="12">
                                        <Border Width="36"
                                                Height="36"
                                                VerticalAlignment="Top"
                                                CornerRadius="10"
                                                Background="{DynamicResource SemiColorFill1}">
                                            <PathIcon Width="18"
                                                      Height="18"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource SemiColorPrimary}"
                                                      Theme="{DynamicResource InnerPathIcon}"
                                                      Data="{Binding Icon}" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Spacing="2">
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SemiColorText0}"
                                                       Text="{Binding Title}" />
                                            <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Description}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Theme="{DynamicResource CardBorder}">
                    <StackPanel Margin="20"
                                Spacing="14">
                        <TextBlock FontSize="{DynamicResource SemiFontSizeHeader6}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText0}"
                                   Text="操作提示" />

                        <StackPanel Spacing="10">
                            <Border Padding="12,10"
                                    CornerRadius="8"
                                    Background="{DynamicResource SemiColorFill0}">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{DynamicResource SemiColorText0}"
                                               Text="Ctrl + 滚轮" />
                                    <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                               Text="放大或缩小当前文档页布局" />
                                </StackPanel>
                            </Border>

                            <Border Padding="12,10"
                                    CornerRadius="8"
                                    Background="{DynamicResource SemiColorFill0}">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{DynamicResource SemiColorText0}"
                                               Text="Ctrl + 中键" />
                                    <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                               Text="恢复页面缩放至 100%" />
                                </StackPanel>
                            </Border>

                            <Border Padding="12,10"
                                    CornerRadius="8"
                                    Background="{DynamicResource SemiColorFill0}">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{DynamicResource SemiColorText0}"
                                               Text="左侧导航" />
                                    <TextBlock Foreground="{DynamicResource SemiColorText2}"
                                               Text="工作区与系统分组切换示例页面" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
