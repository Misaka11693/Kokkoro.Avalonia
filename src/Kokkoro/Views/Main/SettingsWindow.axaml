<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:animation="using:Avalonia.Animation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:u="https://irihi.tech/ursa"
              xmlns:vm="using:Kokkoro.ViewModels.Main"
              mc:Ignorable="d"
              x:Class="Kokkoro.Views.Main.SettingsWindow"
              x:DataType="vm:SettingsWindowViewModel"
              Width="960"
              Height="680"
              MinWidth="820"
              MinHeight="600"
              CanResize="True"
              WindowStartupLocation="CenterOwner"
              ExtendClientAreaToDecorationsHint="True"
              Title="设置">
    <Grid Margin="0,30,0,0"
          Background="{DynamicResource SemiColorBg0}"
          ColumnDefinitions="Auto,*"
          ColumnSpacing="10">
        <Border Padding="8,4"
                VerticalAlignment="Stretch"
                Theme="{DynamicResource CardBorder}">
            <u:NavMenu Name="SettingsNavMenu"
                       HeaderBinding="{Binding Title}"
                       IconBinding="{Binding Icon}"
                       ItemsSource="{Binding SettingsMenuItems}"
                       SubMenuBinding="{Binding Children}"
                       SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                       ExpandWidth="200">
                <u:NavMenu.IconTemplate>
                    <DataTemplate DataType="Geometry">
                        <PathIcon Width="16"
                                  Height="16"
                                  Theme="{DynamicResource InnerPathIcon}"
                                  Data="{Binding}" />
                    </DataTemplate>
                </u:NavMenu.IconTemplate>
                <u:NavMenu.Styles>
                    <Style Selector="u|NavMenuItem">
                        <Setter Property="IsSeparator"
                                Value="{ReflectionBinding IsSeparator}" />
                    </Style>
                </u:NavMenu.Styles>
                <u:NavMenu.Header>
                    <Grid HorizontalAlignment="Center"
                          ColumnDefinitions="Auto,Auto">
                        <Border Grid.Column="0"
                                Width="32"
                                Height="32"
                                Margin="4,12"
                                Background="Transparent"
                                u:NavMenu.CanToggle="True">
                            <PathIcon Width="16"
                                      Height="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Theme="{DynamicResource InnerPathIcon}"
                                      Data="{StaticResource SemiIconSetting}" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="H5"
                            Text="设置"
                            IsVisible="{Binding !#SettingsNavMenu.IsHorizontalCollapsed}"
                            Theme="{DynamicResource TitleTextBlock}" />
                    </Grid>
                </u:NavMenu.Header>
            </u:NavMenu>
        </Border>

        <Border Grid.Column="1"
                Padding="8,4"
                Theme="{DynamicResource CardBorder}">
            <TransitioningContentControl Content="{Binding SelectedMenuItem.Content}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch">
                <TransitioningContentControl.PageTransition>
                    <animation:CrossFade Duration="0:0:0.16" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Border>
    </Grid>
</u:UrsaWindow>
