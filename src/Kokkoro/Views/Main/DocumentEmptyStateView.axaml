<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Kokkoro.ViewModels.Main"
             mc:Ignorable="d"
             x:Class="Kokkoro.Views.Main.DocumentEmptyStateView"
             x:DataType="vm:DocumentEmptyStateViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Design.DataContext>
        <vm:DocumentEmptyStateViewModel />
    </Design.DataContext>
    <Grid  Background= "{DynamicResource SemiLime0}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="{DynamicResource SemiFontSizeHeader3}"
                       FontWeight="SemiBold"
                       Text="{Binding Title}" />
            <TextBlock HorizontalAlignment="Center"
                       Opacity="0.7"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding Description}" />
        </StackPanel>
    </Grid>
</UserControl>
