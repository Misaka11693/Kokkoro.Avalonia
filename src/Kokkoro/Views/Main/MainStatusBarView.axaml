<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Kokkoro.ViewModels.Main"
             mc:Ignorable="d"
             x:Class="Kokkoro.Views.Main.MainStatusBarView"
             x:DataType="vm:MainStatusBarViewModel">
    <Border Padding="16,8"
            Background="{DynamicResource SemiGreen0}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,1,0,0">
        <TextBlock HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource SemiFontSizeSmall}"
                   Foreground="{DynamicResource SemiColorText2}"
                   Text="{Binding ThemeText}" />
    </Border>
</UserControl>
