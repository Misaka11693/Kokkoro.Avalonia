<!-- 空文档页 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kokkoro.Core.Workbench.Docking"
             mc:Ignorable="d"
             x:Class="Kokkoro.Core.Workbench.Docking.DocumentEmptyStateView"
             x:DataType="vm:DocumentEmptyStateViewModel">
    <Design.DataContext>
        <vm:DocumentEmptyStateViewModel />
    </Design.DataContext>

    <Border Background='SeaShell'>
        <Grid>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="{DynamicResource SemiFontSizeHeader3}"
                           FontWeight="SemiBold"
                           Text="{Binding Title}" />
                <TextBlock HorizontalAlignment="Center"
                           Opacity="0.7"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding Description}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>