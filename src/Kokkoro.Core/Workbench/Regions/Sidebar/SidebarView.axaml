<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kokkoro.Core.Workbench.Regions.Sidebar"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="260"
             x:Class="Kokkoro.Core.Workbench.Regions.Sidebar.SidebarView"
             x:DataType="vm:SidebarViewModel">
    <Border
        Padding="8,4"
        VerticalAlignment="Stretch"
        Theme="{DynamicResource CardBorder}">
        <u:NavMenu Name="SidebarMenu"
                   Classes="enable_animation"
                   HeaderBinding="{Binding Title}"
                   CommandBinding="{Binding ActivateCommand}"
                   IconBinding="{Binding Icon}"
                   ItemsSource="{Binding NavigationItems}"
                   SubMenuBinding="{Binding Children}"
                   SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                   IsHorizontalCollapsed="{Binding IsCollapsed, Mode=TwoWay}"
                   ExpandWidth="200"
                   CollapseWidth="64">
            <!-- 文字样式：:selected 选中项；:highlighted 子项选中时的父分组。不设 NavMenuItem.Foreground，避免兄弟子项继承变蓝。图标见 TwoTonePathIcon + IsHighlighted -->
            <u:NavMenu.Styles>
                <!-- 选中叶子项：蓝字 + 加粗 -->
                <Style Selector="u|NavMenuItem:selected">
                    <Setter Property="Foreground" Value="{DynamicResource SemiBlue5}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
                <Style Selector="u|NavMenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource SemiBlue5}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
                <Style Selector="u|NavMenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter TextBlock">
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
                <!-- 子项选中时父分组标题：蓝字 + 加粗（仅 PART_HeaderPresenter，不影响同组未选中子项） -->
                <Style
                    Selector="u|NavMenuItem:highlighted:not(:selected) /template/ ContentPresenter#PART_HeaderPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource SemiBlue5}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
                <Style
                    Selector="u|NavMenuItem:highlighted:not(:selected) /template/ ContentPresenter#PART_HeaderPresenter TextBlock">
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </u:NavMenu.Styles>
            <u:NavMenu.IconTemplate>
                <DataTemplate DataType="Geometry">
                    <u:TwoTonePathIcon Width="16"
                                       Height="16"
                                       ActiveForeground="{DynamicResource SemiBlue5}"
                                       ActiveStrokeBrush="{DynamicResource SemiBlue5}"
                                       Data="{Binding}"
                                       Foreground="{DynamicResource SemiGrey5}"
                                       IsActive="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=u:NavMenuItem}, Path=IsHighlighted, Mode=TwoWay}"
                                       StrokeBrush="{DynamicResource SemiGrey5}" />
                </DataTemplate>
            </u:NavMenu.IconTemplate>
            <u:NavMenu.Header>
                <DockPanel Margin="8,20,8,8"
                           HorizontalAlignment="Center">
                    <Border Width="32"
                            Height="32"
                            CornerRadius="8"
                            Padding="2"
                            Background="{DynamicResource SemiColorFill0}"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="1"
                            DockPanel.Dock="Left"
                            u:NavMenu.CanToggle="True">
                        <Border CornerRadius="6"
                                Background="{DynamicResource SemiColorBg0}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource SemiFontSizeHeader5}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SemiColorPrimary}"
                                       Text="K" />
                        </Border>
                    </Border>
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource SemiFontSizeHeader4}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText0}"
                               IsVisible="{Binding !#SidebarMenu.IsHorizontalCollapsed}"
                               Text="Kokkoro" />
                </DockPanel>
            </u:NavMenu.Header>
        </u:NavMenu>
    </Border>
</UserControl>