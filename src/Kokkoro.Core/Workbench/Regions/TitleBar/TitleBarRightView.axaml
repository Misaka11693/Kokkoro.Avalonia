<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:Kokkoro.Core.Workbench.Regions.TitleBar"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="40"
             x:Class="Kokkoro.Core.Workbench.Regions.TitleBar.TitleBarRightView"
             x:DataType="vm:TitleBarRightViewModel">
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,0,12,0"
                Spacing="8">
        <!-- <views:UserAccountButtonView x:Name="UserAccountButtonView" /> -->

        <u:ThemeToggleButton
            IsThreeState="True"
            Mode="Controller"
            ToolTip.Tip="切换主题：浅色 / 深色 / 跟随系统" />
    </StackPanel>
</UserControl>
